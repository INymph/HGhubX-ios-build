+/// 触感反馈：iOS 用原生 `UIFeedbackGenerator`（WKWebView 里没有 `navigator.vibrate`）。
+/// 返回 `false` 表示本次没有走原生通道，前端据此回退到 Web Vibration，
+/// 保证同一个动作只震一次。iOS 的反馈发生器要求主线程，这里统一切过去。
+#[tauri::command]
+pub fn haptic(app: tauri::AppHandle, kind: String) -> Result<bool, String> {
+    #[cfg(target_os = "ios")]
+    {
+        let queued = app
+            .run_on_main_thread(move || {
+                crate::ios_haptic::play(&kind);
+            })
+            .is_ok();
+        Ok(queued)
+    }
+    #[cfg(not(target_os = "ios"))]
+    {
+        let _ = (&app, kind);
+        Ok(false)
+    }
+}
+
diff --git a/src/shared/lib/haptics.ts b/src/shared/lib/haptics.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/lib/haptics.ts
@@ -0,0 +1,71 @@
+import { invoke } from "@tauri-apps/api/core";
+import { isIos } from "../api/api";
+
+/**
+ * 触感反馈。
+ *
+ * 这里统一收口，是因为仓库原来散落着 `navigator.vibrate?.()`：它在安卓 WebView 里能用，
+ * 在 iOS WKWebView 里根本不存在这个方法，iOS 用户一直是「点了没感觉」。
+ * 现在 iOS 走原生命令 `haptic`（`src-tauri/src/ios_haptic.rs`），其它平台仍用 Web Vibration。
+ */
+
+/** 反馈档位；与 `ios_haptic::play` 的字符串一一对应，不要单独改名。 */
+export type HapticKind = "light" | "medium" | "heavy" | "selection" | "success" | "warning" | "error";
+
+/** Web Vibration 回退时长（毫秒）。数值按手感调过，不要随意放大。 */
+const VIBRATE_MS: Record<HapticKind, number | number[]> = {
+  selection: 8,
+  light: 12,
+  medium: 22,
+  heavy: 32,
+  success: [10, 40, 12],
+  warning: 18,
+  error: [14, 46, 14],
+};
+
+/** 同类反馈的最小间隔：连点、拖动进度时要合并，否则会变成持续嗡嗡响。 */
+const MIN_GAP_MS = 45;
+
+let lastAt = 0;
+/** 原生通道失败一次就长期降级，避免每次交互都白跑一趟 IPC。 */
+let nativeBroken = false;
+
+function web(kind: HapticKind) {
+  try {
+    navigator.vibrate?.(VIBRATE_MS[kind]);
+  } catch {
+    /* 不支持的设备就当没有这回事，震动绝不能影响交互本身 */
+  }
+}
+
+/** 原生通道当前是否可用（只读，便于诊断与测试）。 */
+export function hapticNativeReady(): boolean {
+  return isIos && !nativeBroken;
+}
+
+/**
+ * 触发一次触感。
+ * @param kind 档位，默认 `light`
+ * @param gapMs 与上一次反馈的最小间隔；滑动类交互传更大的值（例如 120）来进一步降频
+ */
+export function haptic(kind: HapticKind = "light", gapMs = MIN_GAP_MS): void {
+  const now = typeof performance !== "undefined" ? performance.now() : Date.now();
+  if (now - lastAt < gapMs) return;
+  lastAt = now;
+  if (!hapticNativeReady()) {
+    web(kind);
+    return;
+  }
+  invoke<boolean>("haptic", { kind })
+    .then((native) => { if (!native) web(kind); })
+    .catch(() => { nativeBroken = true; web(kind); });
+}
+
+/** 开关类：打开用 `medium`（更有确认感），关闭用 `light`。 */
+export const hapticToggle = (on: boolean) => haptic(on ? "medium" : "light");
+
+/** 选项、Tab、分段控件切换：iOS 原生的 selection 质感。 */
+export const hapticSelect = () => haptic("selection", 60);
+
+/** 滑动连续取值（音量、进度、倍速拖动）：间隔拉到 120ms，按下与松手各一次。 */
+export const hapticSlide = () => haptic("selection", 120);
diff --git a/src-tauri/src/ios_haptic.rs b/src-tauri/src/ios_haptic.rs
new file mode 100644
--- /dev/null
+++ b/src-tauri/src/ios_haptic.rs
@@ -0,0 +1,79 @@
+//! iOS 触感反馈。
+//!
+//! WKWebView 没有 `navigator.vibrate`，前端原来的 `navigator.vibrate?.()` 在 iOS 上
+//! 一直是空调用；这里用 objc2 直接向 `UIFeedbackGenerator` 家族发消息，
+//! 不新增 crate 依赖，也不需要额外的 objc2-ui-kit 特性位。
+//!
+//! 调用方（`api::platform::haptic`）保证在本模块的函数里只做「触发一次」，
+//! 频次控制交给前端（`src/shared/lib/haptics.ts` 里 45ms 合并）。
+
+use objc2::rc::autoreleasepool;
+use objc2::runtime::AnyObject;
+use objc2::{class, msg_send};
+
+/// `UIImpactFeedbackStyle`：Light = 0，Medium = 1，Heavy = 2。
+fn impact(style: i64) -> bool {
+    unsafe {
+        let gen: *mut AnyObject = msg_send![class!(UIImpactFeedbackGenerator), alloc];
+        if gen.is_null() {
+            return false;
+        }
+        let gen: *mut AnyObject = msg_send![gen, initWithStyle: style];
+        if gen.is_null() {
+            return false;
+        }
+        let _: () = msg_send![gen, prepare];
+        let _: () = msg_send![gen, impactOccurred];
+        let _: () = msg_send![gen, release];
+    }
+    true
+}
+
+fn selection() -> bool {
+    unsafe {
+        let gen: *mut AnyObject = msg_send![class!(UISelectionFeedbackGenerator), alloc];
+        if gen.is_null() {
+            return false;
+        }
+        let gen: *mut AnyObject = msg_send![gen, init];
+        if gen.is_null() {
+            return false;
+        }
+        let _: () = msg_send![gen, prepare];
+        let _: () = msg_send![gen, selectionChanged];
+        let _: () = msg_send![gen, release];
+    }
+    true
+}
+
+/// `UINotificationFeedbackType`：Success = 0，Warning = 1，Error = 2。
+fn notification(kind: i64) -> bool {
+    unsafe {
+        let gen: *mut AnyObject = msg_send![class!(UINotificationFeedbackGenerator), alloc];
+        if gen.is_null() {
+            return false;
+        }
+        let gen: *mut AnyObject = msg_send![gen, init];
+        if gen.is_null() {
+            return false;
+        }
+        let _: () = msg_send![gen, prepare];
+        let _: () = msg_send![gen, notificationOccurred: kind];
+        let _: () = msg_send![gen, release];
+    }
+    true
+}
+
+/// 触发一次触感；未知档位按 `light` 处理，保证调用方不会因为拼错字符串而静默丢反馈。
+pub fn play(kind: &str) -> bool {
+    autoreleasepool(|_| match kind {
+        "selection" => selection(),
+        "light" => impact(0),
+        "medium" => impact(1),
+        "heavy" => impact(2),
+        "success" => notification(0),
+        "warning" => notification(1),
+        "error" => notification(2),
+        _ => impact(0),
+    })
+}
