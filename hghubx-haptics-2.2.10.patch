diff --git a/src-tauri/src/ios_haptic.rs b/src-tauri/src/ios_haptic.rs
new file mode 100644
--- /dev/null
+++ b/src-tauri/src/ios_haptic.rs
@@ -0,0 +1,79 @@
+//! iOS 触感反馈。
+//!
+//! WKWebView 没有 `navigator.vibrate`，前端原来的 `navigator.vibrate?.()` 在 iOS 上
+//! 一直是空调用；这里用 objc2 直接向 `UIFeedbackGenerator` 家族发消息，
+//! 不新增 crate 依赖，也不需要额外的 objc2-ui-kit 特性位。
+//!
+//! 调用方（`api::platform::haptic`）保证在本模块的函数里只做「触发一次」，
+//! 频次控制交给前端（`src/shared/lib/haptics.ts` 里 45ms 合并）。
+
+use objc2::rc::autoreleasepool;
+use objc2::runtime::AnyObject;
+use objc2::{class, msg_send};
+
+/// `UIImpactFeedbackStyle`：Light = 0，Medium = 1，Heavy = 2。
+fn impact(style: i64) -> bool {
+    unsafe {
+        let gen: *mut AnyObject = msg_send![class!(UIImpactFeedbackGenerator), alloc];
+        if gen.is_null() {
+            return false;
+        }
+        let gen: *mut AnyObject = msg_send![gen, initWithStyle: style];
+        if gen.is_null() {
+            return false;
+        }
+        let _: () = msg_send![gen, prepare];
+        let _: () = msg_send![gen, impactOccurred];
+        let _: () = msg_send![gen, release];
+    }
+    true
+}
+
+fn selection() -> bool {
+    unsafe {
+        let gen: *mut AnyObject = msg_send![class!(UISelectionFeedbackGenerator), alloc];
+        if gen.is_null() {
+            return false;
+        }
+        let gen: *mut AnyObject = msg_send![gen, init];
+        if gen.is_null() {
+            return false;
+        }
+        let _: () = msg_send![gen, prepare];
+        let _: () = msg_send![gen, selectionChanged];
+        let _: () = msg_send![gen, release];
+    }
+    true
+}
+
+/// `UINotificationFeedbackType`：Success = 0，Warning = 1，Error = 2。
+fn notification(kind: i64) -> bool {
+    unsafe {
+        let gen: *mut AnyObject = msg_send![class!(UINotificationFeedbackGenerator), alloc];
+        if gen.is_null() {
+            return false;
+        }
+        let gen: *mut AnyObject = msg_send![gen, init];
+        if gen.is_null() {
+            return false;
+        }
+        let _: () = msg_send![gen, prepare];
+        let _: () = msg_send![gen, notificationOccurred: kind];
+        let _: () = msg_send![gen, release];
+    }
+    true
+}
+
+/// 触发一次触感；未知档位按 `light` 处理，保证调用方不会因为拼错字符串而静默丢反馈。
+pub fn play(kind: &str) -> bool {
+    autoreleasepool(|_| match kind {
+        "selection" => selection(),
+        "light" => impact(0),
+        "medium" => impact(1),
+        "heavy" => impact(2),
+        "success" => notification(0),
+        "warning" => notification(1),
+        "error" => notification(2),
+        _ => impact(0),
+    })
+}
