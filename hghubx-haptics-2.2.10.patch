diff --git a/src/shared/lib/haptics.ts b/src/shared/lib/haptics.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/lib/haptics.ts
@@ -0,0 +1,71 @@
+import { invoke } from "@tauri-apps/api/core";
+import { isIos } from "../api/api";
+
+/**
+ * 触感反馈。
+ *
+ * 这里统一收口，是因为仓库原来散落着 `navigator.vibrate?.()`：它在安卓 WebView 里能用，
+ * 在 iOS WKWebView 里根本不存在这个方法，iOS 用户一直是「点了没感觉」。
+ * 现在 iOS 走原生命令 `haptic`（`src-tauri/src/ios_haptic.rs`），其它平台仍用 Web Vibration。
+ */
+
+/** 反馈档位；与 `ios_haptic::play` 的字符串一一对应，不要单独改名。 */
+export type HapticKind = "light" | "medium" | "heavy" | "selection" | "success" | "warning" | "error";
+
+/** Web Vibration 回退时长（毫秒）。数值按手感调过，不要随意放大。 */
+const VIBRATE_MS: Record<HapticKind, number | number[]> = {
+  selection: 8,
+  light: 12,
+  medium: 22,
+  heavy: 32,
+  success: [10, 40, 12],
+  warning: 18,
+  error: [14, 46, 14],
+};
+
+/** 同类反馈的最小间隔：连点、拖动进度时要合并，否则会变成持续嗡嗡响。 */
+const MIN_GAP_MS = 45;
+
+let lastAt = 0;
+/** 原生通道失败一次就长期降级，避免每次交互都白跑一趟 IPC。 */
+let nativeBroken = false;
+
+function web(kind: HapticKind) {
+  try {
+    navigator.vibrate?.(VIBRATE_MS[kind]);
+  } catch {
+    /* 不支持的设备就当没有这回事，震动绝不能影响交互本身 */
+  }
+}
+
+/** 原生通道当前是否可用（只读，便于诊断与测试）。 */
+export function hapticNativeReady(): boolean {
+  return isIos && !nativeBroken;
+}
+
+/**
+ * 触发一次触感。
+ * @param kind 档位，默认 `light`
+ * @param gapMs 与上一次反馈的最小间隔；滑动类交互传更大的值（例如 120）来进一步降频
+ */
+export function haptic(kind: HapticKind = "light", gapMs = MIN_GAP_MS): void {
+  const now = typeof performance !== "undefined" ? performance.now() : Date.now();
+  if (now - lastAt < gapMs) return;
+  lastAt = now;
